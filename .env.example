# Copy this file to .env and set the provider you want to use.
# Do not commit real keys.
MODEL_PROVIDER=ollama

# Ollama settings. The API key is optional for a local Ollama server.
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
OLLAMA_MODEL=your-local-model
OLLAMA_API_KEY=

# OpenAI settings, used when MODEL_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Groq settings, used when MODEL_PROVIDER=groq. Free tier, no credit card:
# https://console.groq.com/keys
# Groq's free-tier catalog rotates without notice - if this model 404s, run
# `pnpm groq:models` (or check console.groq.com/docs/models) and pick a
# current model with total parameters <= 80B.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
